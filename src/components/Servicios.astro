---
import { servicios } from '../data/site';
import SectionHead from './SectionHead.astro';
---

<section class="section" id="servicios">
  <div class="shell">
    <SectionHead
      index="01"
      label="Servicios"
      title="Nutrición deportiva y <br />antropometría en <em>Rosario</em>"
      sub="Dos formas de trabajar el rendimiento, por separado o combinadas: la antropometría aporta los datos de composición corporal y el plan alimentario los convierte en resultados."
    />

    <div class="cards">
      {servicios.map((s, i) => (
        <article class="card" style={`--d:${i * 140}ms`} data-reveal>
          <div class="card-media" aria-hidden="true">
            <video src={s.video} muted loop playsinline preload="none" data-lazyplay></video>
            <div class="card-shade"></div>
          </div>

          <div class="card-body">
            <header class="card-top">
              <span class="mono card-n">{s.n}</span>
              <span class="ruler-x card-rule"></span>
            </header>

            <h3 class="card-title">
              {s.titulo}
              <span class="card-sub">{s.subtitulo}</span>
            </h3>
            <p class="card-claim">{s.claim}</p>
            <p class="card-desc">{s.desc}</p>

            <ul class="card-list">
              {s.puntos.map((p) => (
                <li>
                  <svg width="9" height="9" viewBox="0 0 9 9" fill="none" aria-hidden="true">
                    <path d="M0.5 4.5h8M4.5 0.5v8" stroke="currentColor" stroke-width="1" />
                  </svg>
                  <span>{p}</span>
                </li>
              ))}
            </ul>

            <a class="btn card-cta" href={s.href} target="_blank" rel="noopener">
              {s.cta}
              <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
                <path d="M1 10 10 1M10 1H3.4M10 1v6.6" stroke="currentColor" stroke-width="1.4" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cards {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .card {
    position: relative;
    background: var(--ink);
    overflow: hidden;
    isolation: isolate;
    transition: background 0.6s var(--ease);
  }

  .card-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.16;
    transition: opacity 0.7s var(--ease), transform 1.1s var(--ease);
  }

  .card-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.2);
  }

  .card-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, var(--ink) 12%, transparent 62%, var(--ink) 100%);
  }

  .card:hover .card-media { opacity: 0.3; transform: scale(1.04); }

  .card-body {
    padding: clamp(1.75rem, 4vw, 3.25rem);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .card-n {
    font-size: 0.6875rem;
    color: var(--gold);
    letter-spacing: 0.2em;
  }

  .card-rule { flex: 1; -webkit-mask-image: none; mask-image: none; }

  .card-title {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-variation-settings: 'wdth' 108;
  }

  .card-sub {
    display: block;
    margin-top: 0.7rem;
    font-size: 0.8125rem;
    font-weight: 500;
    font-variation-settings: 'wdth' 92;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--mute);
  }

  .card-claim {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    color: var(--gold);
    margin-top: 0.85rem;
    line-height: 1.4;
  }

  .card-desc {
    margin-top: 1.25rem;
    color: var(--bone-dim);
    font-weight: 300;
    max-width: 46ch;
  }

  .card-list {
    list-style: none;
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
    border-top: 1px solid var(--line-2);
    padding-top: clamp(1.25rem, 3vw, 1.75rem);
  }

  .card-list li {
    display: grid;
    grid-template-columns: 9px minmax(0, 1fr);
    gap: 0.85rem;
    align-items: start;
    font-family: var(--display);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--bone-dim);
  }

  .card-list svg { color: var(--gold); margin-top: 0.42em; }

  .card-list { margin-bottom: clamp(2rem, 5vw, 3rem); }

  .card-cta {
    margin-top: auto;
    align-self: flex-start;
  }
</style>
