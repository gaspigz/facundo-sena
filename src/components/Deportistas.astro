---
import { deportistas } from '../data/site';
import SectionHead from './SectionHead.astro';
---

<section class="section deportistas" id="deportistas">
  <div class="shell">
    <SectionHead
      index="03"
      label="Deportistas"
      title="A quiénes <br /><em>acompaño</em>"
      sub="Ultra trail, maratón, rugby de selección y fútbol profesional. Distintos deportes, el mismo método de nutrición deportiva: medir la composición corporal, planificar la alimentación y sostener el máximo rendimiento en competencia."
    />

    <div class="roster">
      {deportistas.map((d, i) => (
        <article class="atleta" style={`--d:${(i % 3) * 110}ms`} data-reveal>
          <div class="atleta-shot">
            <img src={d.foto} alt={`${d.nombre}, ${d.disciplina}${d.puesto ? ` (${d.puesto})` : ''}, deportista asesorado por el nutricionista deportivo Facundo Sena`} loading="lazy" decoding="async" />
            <span class="mono atleta-n">{String(i + 1).padStart(2, '0')}</span>
          </div>

          <div class="atleta-head">
            <h3 class="atleta-nombre">{d.nombre}</h3>
            <p class="mono atleta-disc">
              {d.disciplina}{d.puesto && <span class="sep"> / </span>}{d.puesto}
            </p>
          </div>

          <ul class="logros">
            {d.logros.map((l) => (
              <li>
                {l.anio && <span class="mono logro-anio">{l.anio}</span>}
                <span class="logro-txt">{l.texto}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .deportistas { background: var(--ink-2); }

  .roster {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem) clamp(1.25rem, 3vw, 2.5rem);
  }

  @media (min-width: 680px)  { .roster { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1080px) { .roster { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .atleta { display: flex; flex-direction: column; }

  .atleta-shot {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--ink-3);
  }

  .atleta-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 28%;
    filter: grayscale(1) contrast(1.1) brightness(0.9);
    transition: filter 0.8s var(--ease), transform 1s var(--ease);
  }

  .atleta:hover .atleta-shot img,
  .atleta:focus-within .atleta-shot img {
    filter: grayscale(0) contrast(1.02);
    transform: scale(1.035);
  }

  .atleta-n {
    position: absolute;
    top: 0.85rem; left: 0.9rem;
    font-size: 0.5625rem;
    color: var(--gold);
    letter-spacing: 0.2em;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.85);
  }

  .atleta-head {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.1rem 0 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .atleta-nombre {
    font-size: clamp(1.0625rem, 1.7vw, 1.25rem);
    font-weight: 700;
    font-variation-settings: 'wdth' 100;
    letter-spacing: -0.005em;
  }

  .atleta-disc { font-size: 0.5625rem; color: var(--gold); letter-spacing: 0.18em; }
  .sep { color: var(--mute-2); }

  .logros {
    list-style: none;
    margin: 0;
    padding: 0.9rem 0 0;
    display: grid;
    gap: 0.5rem;
  }

  .logros li {
    display: grid;
    grid-template-columns: 3.1rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: baseline;
    font-family: var(--display);
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.45;
    color: var(--bone-dim);
  }

  .logros li:has(> .logro-txt:first-child) { grid-template-columns: minmax(0, 1fr); }

  .logro-anio {
    font-size: 0.5625rem;
    color: var(--mute-2);
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
  }
</style>
