---
import { instituciones } from '../data/site';

// La lista va dos veces: la pista se desplaza la mitad de su ancho y empalma sin salto.
const pista = [...instituciones, ...instituciones];
---

<section class="inst" aria-label="Clubes e instituciones" data-reveal>
  <div class="shell inst-head">
    <p class="mono inst-k">Clubes e instituciones</p>
    <span class="ruler-x inst-rule" aria-hidden="true"></span>
  </div>

  <div class="marquee">
    <ul class="marquee-track" aria-label="Clubes e instituciones con las que trabajé">
      {pista.map((i, n) => {
        const copia = n >= instituciones.length;
        return (
          <li class="marca" aria-hidden={copia ? 'true' : undefined}>
            {i.logo ? (
              <img
                class={`marca-img marca-img--${i.forma ?? 'escudo'}`}
                src={i.logo}
                alt={copia ? '' : i.nombre}
                title={i.nombre}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="marca-txt">
                {i.nombre}
                {i.bajada && <span class="mono marca-bajada">{i.bajada}</span>}
              </span>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .inst { padding-block: clamp(2.5rem, 6vw, 4rem) clamp(3.5rem, 8vw, 5.5rem); }

  .inst-head {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: clamp(1.5rem, 3.5vw, 2.25rem);
  }

  .inst-k {
    color: var(--gold);
    letter-spacing: 0.18em;
    white-space: nowrap;
  }

  .inst-rule { flex: 1; -webkit-mask-image: none; mask-image: none; }

  /* ---- cinta infinita ---- */

  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--line);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
  }

  .marquee-track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }

  .marquee:hover .marquee-track { animation-play-state: paused; }

  @keyframes marquee { to { transform: translateX(-50%); } }

  .marca {
    display: flex;
    align-items: center;
    justify-content: center;
    height: clamp(6.5rem, 12vw, 8.5rem);
    padding-inline: clamp(2.25rem, 5vw, 4rem);
    border-right: 1px solid var(--line-2);
  }

  .marca-img {
    width: auto;
    opacity: 0.82;
    filter: saturate(0.85);
    transition: opacity 0.45s var(--ease), filter 0.45s var(--ease), transform 0.6s var(--ease);
  }

  .marca-img--escudo { height: clamp(3.25rem, 6vw, 4.5rem); }
  .marca-img--horizontal { height: clamp(2.25rem, 4vw, 3rem); }

  .marca-txt {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: var(--display);
    font-size: clamp(1.0625rem, 1.8vw, 1.375rem);
    font-weight: 800;
    font-variation-settings: 'wdth' 112;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--bone);
    opacity: 0.82;
    transition: opacity 0.45s var(--ease);
  }

  .marca-bajada {
    font-size: 0.5625rem;
    color: var(--gold);
    letter-spacing: 0.2em;
  }

  .marca:hover .marca-img { opacity: 1; filter: none; transform: scale(1.06); }
  .marca:hover .marca-txt { opacity: 1; }

  /* Sin movimiento: la cinta queda quieta y centrada, sin la copia. */
  @media (prefers-reduced-motion: reduce) {
    .marquee { -webkit-mask-image: none; mask-image: none; }
    .marquee-track { animation: none; width: auto; flex-wrap: wrap; justify-content: center; }
    .marca[aria-hidden] { display: none; }
  }
</style>
