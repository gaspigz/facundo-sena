---
import { perfil, cta } from '../data/site';
import Wordmark from './Wordmark.astro';
---

<section class="hero" id="top">
  <div class="hero-bg" aria-hidden="true">
    <video
      class="hero-video"
      data-hero-video="/videos/hero-gym.mp4"
      muted loop playsinline preload="none"
    ></video>
    <div class="hero-veil"></div>
    <div class="hero-vignette"></div>
  </div>

  <div class="ruler-y hero-ruler" aria-hidden="true"></div>

  <div class="shell hero-in">
    <div class="hero-copy">
      <p class="mono hero-eyebrow">
        <span class="dot" aria-hidden="true"></span>
        Lic. {perfil.nombre} · {perfil.matricula} · {perfil.ciudad}
      </p>

      <h1 class="hero-title">
        <span class="ln"><span>Potenciá tu</span></span>
        <span class="ln"><span class="gold">rendimiento</span></span>
        <span class="hero-h1sub">
          <Wordmark size="1.75em" />
          <span class="hero-h1sub-rule" aria-hidden="true"></span>
          <span>Nutrición deportiva · Rosario</span>
        </span>
      </h1>

      <p class="serif-lead hero-lead">
        Soy Facundo Sena, Licenciado en Nutrición y Antropometrista ISAK 2.
        Acompaño a deportistas y personas activas que buscan mejorar su
        rendimiento, composición corporal y hábitos alimentarios.
      </p>

      <p class="hero-lead-2">
        A través de la evaluación antropométrica y una estrategia nutricional
        personalizada, transformamos datos en decisiones concretas para que
        puedas entrenar, recuperarte y rendir.
      </p>

      <div class="hero-actions">
        <a class="btn btn--gold" href={cta.presencial} target="_blank" rel="noopener">
          Reservar consulta
          <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
            <path d="M1 10 10 1M10 1H3.4M10 1v6.6" stroke="currentColor" stroke-width="1.4" />
          </svg>
        </a>
        <a class="btn" href="#servicios">Ver servicios</a>
      </div>
    </div>

    <figure class="hero-shot">
      <div class="hero-frame">
        <img
          src="/images/facundo-sena.png"
          alt="Lic. Facundo Sena, nutricionista deportivo y antropometrista ISAK II en Rosario"
          width="614" height="1359"
          fetchpriority="high" decoding="async"
        />
      </div>
    </figure>
  </div>

</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: clamp(7rem, 16vh, 11rem);
    overflow: hidden;
    isolation: isolate;
  }

  /* ---- fondo ---- */

  .hero-bg { position: absolute; inset: 0; z-index: -2; }

  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.55) contrast(1.15) brightness(0.5);
    transform: scale(1.06);
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, var(--ink) 0%, transparent 26%, transparent 52%, var(--ink) 96%),
      linear-gradient(100deg, var(--ink) 8%, color-mix(in srgb, var(--ink) 62%, transparent) 46%, transparent 78%);
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 85% at 68% 40%, transparent 38%, rgba(10,10,11,0.85) 100%);
  }

  .hero-ruler { left: 0; top: 0; bottom: 0; z-index: -1; }

  @media (min-width: 1100px) {
    .hero-ruler { left: calc((100vw - var(--max)) / 2 + var(--gut) - 22px); }
  }

  /* ---- grilla ---- */

  .hero-in {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: end;
    padding-bottom: clamp(2.5rem, 6vh, 4.5rem);
    flex: 1;
    align-content: end;
  }

  @media (min-width: 960px) {
    .hero-in {
      grid-template-columns: minmax(0, 1.42fr) minmax(240px, 0.58fr);
      gap: clamp(3rem, 6vw, 6rem);
    }
  }

  /* ---- copy ---- */

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--bone-dim);
    margin-bottom: clamp(1.5rem, 4vw, 2.25rem);
    opacity: 0;
    animation: fade-up 0.9s var(--ease) 0.15s forwards;
  }

  .dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--gold);
    flex: none;
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--gold) 70%, transparent);
    animation: pulse 2.6s ease-out infinite;
  }

  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--gold) 60%, transparent); }
    70%  { box-shadow: 0 0 0 9px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  .hero-title {
    font-size: clamp(2.35rem, 8.6vw, 5.5rem);
    font-weight: 600;
    font-variation-settings: 'wdth' 100;
    line-height: 0.98;
    letter-spacing: -0.015em;
  }

  /* A partir de acá el hero es de dos columnas: el titular ya no dispone del
     ancho completo, así que se mide contra su columna para no recortarse. */
  @media (min-width: 960px) {
    .hero-title { font-size: min(6vw, 5.25rem); }
  }

  .hero-title .ln {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .hero-title .ln > span {
    display: block;
    transform: translateY(105%);
    animation: rise 1.05s var(--ease) forwards;
  }

  .hero-title .ln:nth-child(1) > span { animation-delay: 0.22s; }
  .hero-title .ln:nth-child(2) > span { animation-delay: 0.36s; }

  .hero-h1sub {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    margin-top: clamp(1rem, 2.2vw, 1.5rem);
    font-family: var(--display);
    font-size: clamp(1rem, 1.9vw, 1.375rem);
    font-weight: 500;
    font-variation-settings: 'wdth' 100;
    letter-spacing: 0.01em;
    line-height: 1.3;
    text-transform: none;
    color: var(--bone-dim);
    opacity: 0;
    animation: fade-up 0.9s var(--ease) 0.58s forwards;
  }

  .hero-h1sub-rule {
    width: 1px;
    height: 1.35em;
    background: var(--gold);
  }

  @keyframes rise { to { transform: none; } }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: none; }
  }

  .hero-lead {
    max-width: 46ch;
    margin-top: clamp(1.5rem, 4vw, 2.25rem);
    opacity: 0;
    animation: fade-up 0.9s var(--ease) 0.72s forwards;
  }

  .hero-lead-2 {
    max-width: 48ch;
    margin-top: 1rem;
    color: var(--mute);
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.7;
    opacity: 0;
    animation: fade-up 0.9s var(--ease) 0.8s forwards;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    opacity: 0;
    animation: fade-up 0.9s var(--ease) 0.86s forwards;
  }

  @media (max-width: 520px) {
    .hero-actions { display: grid; grid-template-columns: 1fr; }
    .hero-actions .btn { justify-content: center; }
  }

  /* ---- foto ---- */

  .hero-shot {
    margin: 0;
    opacity: 0;
    animation: fade-up 1.1s var(--ease) 0.5s forwards;
  }

  @media (max-width: 959px) {
    .hero-shot { width: 100%; max-width: 22rem; justify-self: center; }
  }

  /* Recorte sin fondo: la sombra va en el contenedor y no en la imagen,
     porque la máscara del desvanecido la recortaría al rectángulo.
     Tres capas, como luz de estudio desde arriba a la izquierda: contacto
     que define el borde, media distancia y una ambiental larga y difusa. */
  .hero-frame {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    filter:
      drop-shadow(0 1px 1.5px rgba(0,0,0,0.55))
      drop-shadow(6px 16px 22px rgba(0,0,0,0.5))
      drop-shadow(22px 46px 64px rgba(0,0,0,0.6));
  }

  .hero-frame img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 78svh;
    filter: contrast(1.08) saturate(0.88) brightness(0.98);
    -webkit-mask-image: linear-gradient(180deg, #000 74%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 74%, transparent 100%);
  }

</style>
