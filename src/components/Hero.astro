---
import { perfil, stats, cta } from '../data/site';
---

<section class="hero" id="top">
  <div class="hero-bg" aria-hidden="true">
    <video
      class="hero-video"
      data-hero-video="/videos/hero-gym.mp4"
      muted loop playsinline preload="none"
    ></video>
    <div class="hero-veil"></div>
    <div class="hero-vignette"></div>
  </div>

  <div class="ruler-y hero-ruler" aria-hidden="true"></div>

  <div class="shell hero-in">
    <div class="hero-copy">
      <p class="mono hero-eyebrow">
        <span class="dot" aria-hidden="true"></span>
        Lic. {perfil.nombre} · {perfil.matricula} · {perfil.ciudad}
      </p>

      <h1 class="hero-title">
        <span class="ln"><span>Medir.</span></span>
        <span class="ln"><span>Ajustar.</span></span>
        <span class="ln"><span class="gold">Rendir.</span></span>
        <span class="hero-h1sub">Nutricionista deportivo en Rosario</span>
      </h1>

      <p class="serif-lead hero-lead">
        Antropometría ISAK II y planes alimentarios para máximo rendimiento.
        Mido tu composición corporal con protocolo internacional, periodizo la
        alimentación según tu entrenamiento y controlo los cambios cada 20 a 30
        días. Presencial en Mendoza 2290 u online a todo el país.
      </p>

      <div class="hero-actions">
        <a class="btn btn--gold" href={cta.presencial} target="_blank" rel="noopener">
          Reservar consulta
          <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
            <path d="M1 10 10 1M10 1H3.4M10 1v6.6" stroke="currentColor" stroke-width="1.4" />
          </svg>
        </a>
        <a class="btn" href="#servicios">Ver servicios</a>
      </div>
    </div>

    <figure class="hero-shot">
      <div class="hero-frame">
        <img
          src="/perfil1.jpeg"
          alt="Lic. Facundo Sena, nutricionista deportivo y antropometrista ISAK II en Rosario"
          width="1134" height="2016"
          fetchpriority="high" decoding="async"
        />
        <span class="corner tl" aria-hidden="true"></span>
        <span class="corner br" aria-hidden="true"></span>
      </div>
      <figcaption class="mono hero-cap">
        <span>{perfil.isak}</span>
        <span class="hero-cap-n">01</span>
      </figcaption>
    </figure>
  </div>

  <div class="hero-stats shell">
    {stats.map((s, i) => (
      <div class="stat" style={`--d:${240 + i * 90}ms`} data-reveal>
        <span class="mono stat-k">{s.k}</span>
        <span class="stat-v">{s.v}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: clamp(7rem, 16vh, 11rem);
    overflow: hidden;
    isolation: isolate;
  }

  /* ---- fondo ---- */

  .hero-bg { position: absolute; inset: 0; z-index: -2; }

  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.55) contrast(1.15) brightness(0.5);
    transform: scale(1.06);
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, var(--ink) 0%, transparent 26%, transparent 52%, var(--ink) 96%),
      linear-gradient(100deg, var(--ink) 8%, color-mix(in srgb, var(--ink) 62%, transparent) 46%, transparent 78%);
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 85% at 68% 40%, transparent 38%, rgba(10,10,11,0.85) 100%);
  }

  .hero-ruler { left: 0; top: 0; bottom: 0; z-index: -1; }

  @media (min-width: 1100px) {
    .hero-ruler { left: calc((100vw - var(--max)) / 2 + var(--gut) - 22px); }
  }

  /* ---- grilla ---- */

  .hero-in {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: end;
    padding-bottom: clamp(2.5rem, 6vh, 4.5rem);
    flex: 1;
    align-content: end;
  }

  @media (min-width: 960px) {
    .hero-in {
      grid-template-columns: minmax(0, 1.42fr) minmax(240px, 0.58fr);
      gap: clamp(3rem, 6vw, 6rem);
    }
  }

  /* ---- copy ---- */

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--bone-dim);
    margin-bottom: clamp(1.5rem, 4vw, 2.25rem);
    opacity: 0;
    animation: fade-up 0.9s var(--ease) 0.15s forwards;
  }

  .dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--gold);
    flex: none;
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--gold) 70%, transparent);
    animation: pulse 2.6s ease-out infinite;
  }

  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--gold) 60%, transparent); }
    70%  { box-shadow: 0 0 0 9px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  .hero-title {
    font-size: clamp(3.25rem, 13vw, 9.5rem);
    font-weight: 900;
    font-variation-settings: 'wdth' 118;
    line-height: 0.85;
    letter-spacing: -0.035em;
  }

  /* A partir de acá el hero es de dos columnas: el titular ya no dispone del
     ancho completo, así que se mide contra su columna para no recortarse. */
  @media (min-width: 960px) {
    .hero-title { font-size: min(9.9vw, 8.9rem); }
  }

  .hero-title .ln {
    display: block;
    overflow: hidden;
  }

  .hero-title .ln > span {
    display: block;
    transform: translateY(105%);
    animation: rise 1.05s var(--ease) forwards;
  }

  .hero-title .ln:nth-child(1) > span { animation-delay: 0.22s; }
  .hero-title .ln:nth-child(2) > span { animation-delay: 0.34s; }
  .hero-title .ln:nth-child(3) > span { animation-delay: 0.46s; }

  .hero-h1sub {
    display: block;
    margin-top: clamp(1rem, 2.2vw, 1.5rem);
    font-family: var(--display);
    font-size: clamp(1rem, 1.9vw, 1.375rem);
    font-weight: 500;
    font-variation-settings: 'wdth' 100;
    letter-spacing: 0.01em;
    line-height: 1.3;
    text-transform: none;
    color: var(--bone-dim);
    opacity: 0;
    animation: fade-up 0.9s var(--ease) 0.58s forwards;
  }

  .hero-h1sub::before {
    content: '';
    display: inline-block;
    width: 1.75rem;
    height: 1px;
    background: var(--gold);
    vertical-align: 0.35em;
    margin-right: 0.7rem;
  }

  @keyframes rise { to { transform: none; } }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: none; }
  }

  .hero-lead {
    max-width: 46ch;
    margin-top: clamp(1.5rem, 4vw, 2.25rem);
    opacity: 0;
    animation: fade-up 0.9s var(--ease) 0.72s forwards;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    opacity: 0;
    animation: fade-up 0.9s var(--ease) 0.86s forwards;
  }

  @media (max-width: 520px) {
    .hero-actions { display: grid; grid-template-columns: 1fr; }
    .hero-actions .btn { justify-content: center; }
  }

  /* ---- foto ---- */

  .hero-shot {
    margin: 0;
    opacity: 0;
    animation: fade-up 1.1s var(--ease) 0.5s forwards;
  }

  @media (max-width: 959px) {
    .hero-shot { max-width: 22rem; }
  }

  .hero-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--ink-2);
  }

  .hero-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
    filter: contrast(1.06) saturate(0.9);
  }

  .corner {
    position: absolute;
    width: 18px; height: 18px;
    border: 1px solid var(--gold);
  }
  .corner.tl { top: 10px; left: 10px; border-right: 0; border-bottom: 0; }
  .corner.br { bottom: 10px; right: 10px; border-left: 0; border-top: 0; }

  .hero-cap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.75rem;
    color: var(--mute);
    font-size: 0.625rem;
  }

  .hero-cap-n { color: var(--gold); }

  /* ---- barra de credenciales ---- */

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  @media (min-width: 860px) {
    .hero-stats { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: clamp(1.1rem, 2.5vw, 1.6rem) clamp(0.9rem, 2vw, 1.5rem) clamp(1.1rem, 2.5vw, 1.6rem) 0;
    border-right: 1px solid var(--line);
  }

  .stat:last-child { border-right: 0; }

  @media (max-width: 859px) {
    .stat:nth-child(2n) { border-right: 0; }
    .stat:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
  }

  .stat-k { color: var(--gold); font-size: 0.625rem; }

  .stat-v {
    font-family: var(--display);
    font-size: clamp(0.8125rem, 1.4vw, 0.9375rem);
    font-weight: 500;
    font-variation-settings: 'wdth' 100;
    line-height: 1.35;
    color: var(--bone-dim);
    text-transform: none;
    letter-spacing: 0;
  }
</style>
