---
import { cta, perfil } from '../data/site';

const opciones = [
  { t: 'Antropometría',   d: 'Composición corporal ISAK II', href: cta.antropometria },
  { t: 'Consulta presencial', d: 'Mendoza 2290, Rosario',    href: cta.presencial },
  { t: 'Consulta online',     d: 'Videollamada a coordinar', href: cta.online },
];
---

<div class="fab" data-fab>
  <div class="fab-panel" id="fab-panel" role="dialog" aria-label="Pedir turno por WhatsApp" hidden>
    <div class="fab-head">
      <span class="fab-avatar" aria-hidden="true">
        <img src="/avatar-fs.jpg" alt="" width="200" height="200" decoding="async" />
        <span class="fab-on"></span>
      </span>
      <span class="fab-who">
        <strong>Lic. Facundo Sena</strong>
        <span class="mono">Suele responder en el día</span>
      </span>
      <button class="fab-x" type="button" data-fab-close aria-label="Cerrar">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </div>

    <p class="fab-msg">
      ¡Hola! ¿Sobre qué querés coordinar? Contame tus objetivos y qué actividad
      física hacés.
    </p>

    <ul class="fab-list">
      {opciones.map((o) => (
        <li>
          <a href={o.href} target="_blank" rel="noopener">
            <span class="fab-txt">
              <span class="fab-t">{o.t}</span>
              <span class="fab-d">{o.d}</span>
            </span>
            <svg class="fab-arrow" width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
              <path d="M1 10 10 1M10 1H3.4M10 1v6.6" stroke="currentColor" stroke-width="1.4" />
            </svg>
          </a>
        </li>
      ))}
    </ul>

    <p class="fab-foot mono">{perfil.telefono}</p>
  </div>

  <button
    class="fab-btn"
    type="button"
    data-fab-toggle
    aria-expanded="false"
    aria-controls="fab-panel"
  >
    <span class="fab-ico fab-ico--wa" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 16 16" fill="currentColor">
        <path d="M13.6 2.33A7.9 7.9 0 0 0 8 0a7.94 7.94 0 0 0-6.88 11.9L0 16l4.2-1.1A7.93 7.93 0 0 0 8 15.87 7.94 7.94 0 0 0 13.6 2.33ZM8 14.53a6.6 6.6 0 0 1-3.36-.92l-.24-.14-2.5.65.67-2.43-.16-.25a6.59 6.59 0 1 1 5.59 3.09Zm3.62-4.94c-.2-.1-1.17-.58-1.35-.64-.18-.07-.31-.1-.44.1s-.51.64-.63.77-.23.15-.43.05a5.4 5.4 0 0 1-1.6-.98 6 6 0 0 1-1.1-1.37c-.12-.2 0-.31.09-.41s.2-.23.3-.35a1.4 1.4 0 0 0 .2-.33.37.37 0 0 0 0-.35c0-.1-.44-1.07-.6-1.46s-.32-.33-.44-.34h-.38a.72.72 0 0 0-.52.24 2.19 2.19 0 0 0-.69 1.63 3.81 3.81 0 0 0 .8 2.02 8.72 8.72 0 0 0 3.33 2.94 11.2 11.2 0 0 0 1.11.41 2.67 2.67 0 0 0 1.23.08 2 2 0 0 0 1.32-.93 1.64 1.64 0 0 0 .11-.93c-.05-.08-.18-.13-.38-.23Z" />
      </svg>
    </span>
    <span class="fab-ico fab-ico--x" aria-hidden="true">
      <svg width="15" height="15" viewBox="0 0 12 12" fill="none">
        <path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.8" />
      </svg>
    </span>
    <span class="fab-label">Pedir turno</span>
    <span class="fab-ping" aria-hidden="true"></span>
  </button>
</div>

<style>
  .fab {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 950;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    opacity: 0;
    transform: translateY(14px);
    pointer-events: none;
    transition: opacity 0.5s var(--ease), transform 0.5s var(--ease);
  }

  .fab.is-on { opacity: 1; transform: none; pointer-events: auto; }

  /* ---- botón ---- */

  .fab-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 3.25rem;
    padding-inline: 1.05rem;
    background: var(--gold);
    color: #14100A;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 10px 30px -8px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(0, 0, 0, 0.25);
    transition: transform 0.35s var(--ease), background 0.35s var(--ease);
  }

  .fab-btn:hover { transform: translateY(-2px); background: var(--gold-hi); }
  .fab-btn:active { transform: translateY(0); }

  .fab-label {
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .fab-ico { display: grid; place-items: center; transition: opacity 0.25s var(--ease), transform 0.35s var(--ease); }
  .fab-ico--x { position: absolute; left: 1.05rem; opacity: 0; transform: rotate(-90deg); }

  .fab[data-open] .fab-ico--wa { opacity: 0; transform: rotate(90deg); }
  .fab[data-open] .fab-ico--x  { opacity: 1; transform: none; }
  .fab[data-open] .fab-label   { opacity: 0.55; }

  /* halo que late para llamar la atención sin ser intrusivo */
  .fab-ping {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--gold) 65%, transparent);
    animation: fab-ping 3.4s ease-out infinite;
    pointer-events: none;
  }

  .fab[data-open] .fab-ping { animation: none; }

  @keyframes fab-ping {
    0%       { box-shadow: 0 0 0 0 color-mix(in srgb, var(--gold) 55%, transparent); }
    45%, 100% { box-shadow: 0 0 0 16px transparent; }
  }

  /* ---- panel ---- */

  .fab-panel {
    width: min(21rem, calc(100vw - 2rem));
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: 4px;
    box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.85);
    overflow: hidden;
    transform-origin: bottom right;
    animation: fab-in 0.42s var(--ease) both;
  }

  .fab-panel[hidden] { display: none; }

  @keyframes fab-in {
    from { opacity: 0; transform: translateY(10px) scale(0.96); }
    to   { opacity: 1; transform: none; }
  }

  .fab-head {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
    gap: 0.75rem;
    align-items: center;
    padding: 0.9rem 1rem;
    background: var(--ink-3);
    border-bottom: 1px solid var(--line);
  }

  .fab-avatar { position: relative; display: block; }

  .fab-avatar img {
    width: 2.5rem; height: 2.5rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 22%;
  }

  .fab-on {
    position: absolute;
    right: -1px; bottom: -1px;
    width: 0.6rem; height: 0.6rem;
    border-radius: 50%;
    background: #2ECC71;
    border: 2px solid var(--ink-3);
  }

  .fab-who { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }

  .fab-who strong {
    font-family: var(--display);
    font-size: 0.875rem;
    font-weight: 600;
    font-variation-settings: 'wdth' 100;
    color: var(--bone);
  }

  .fab-who .mono { font-size: 0.5rem; color: var(--mute); letter-spacing: 0.12em; }

  .fab-x {
    display: grid;
    place-items: center;
    width: 1.5rem; height: 1.5rem;
    color: var(--mute);
    cursor: pointer;
    border-radius: 2px;
    transition: color 0.3s var(--ease);
  }

  .fab-x:hover { color: var(--bone); }

  .fab-msg {
    margin: 0;
    padding: 1rem 1rem 0.9rem;
    font-size: 0.8125rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--bone-dim);
  }

  .fab-list { list-style: none; margin: 0; padding: 0 0.5rem 0.5rem; display: grid; gap: 2px; }

  .fab-list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 11px;
    gap: 0.75rem;
    align-items: center;
    padding: 0.7rem 0.55rem;
    border-radius: 2px;
    transition: background 0.3s var(--ease);
  }

  .fab-list a:hover,
  .fab-list a:focus-visible { background: var(--ink-4); }

  .fab-txt { display: block; min-width: 0; }

  .fab-t {
    display: block;
    font-family: var(--display);
    font-size: 0.8125rem;
    font-weight: 600;
    font-variation-settings: 'wdth' 100;
    color: var(--bone);
  }

  .fab-d { display: block; font-size: 0.6875rem; font-weight: 300; color: var(--mute); margin-top: 0.1rem; }

  .fab-arrow { color: var(--gold); }

  .fab-foot {
    margin: 0;
    padding: 0.7rem 1rem 0.9rem;
    border-top: 1px solid var(--line-2);
    font-size: 0.5625rem;
    color: var(--mute-2);
    text-align: center;
    letter-spacing: 0.16em;
  }

  @media (max-width: 420px) {
    .fab-label { display: none; }
    .fab-btn { width: 3.25rem; padding-inline: 0; justify-content: center; }
    .fab-ico--x { left: 50%; margin-left: -7px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fab-ping { animation: none; }
    .fab-panel { animation: none; }
  }
</style>

<script>
  const fab = document.querySelector<HTMLElement>('[data-fab]');
  const btn = document.querySelector<HTMLButtonElement>('[data-fab-toggle]');
  const panel = document.querySelector<HTMLElement>('#fab-panel');

  if (fab && btn && panel) {
    const abrir = (v: boolean) => {
      panel.hidden = !v;
      btn.setAttribute('aria-expanded', String(v));
      fab.toggleAttribute('data-open', v);
      if (v) panel.querySelector<HTMLAnchorElement>('a')?.focus();
    };

    btn.addEventListener('click', () => abrir(panel.hidden));
    fab.querySelector('[data-fab-close]')?.addEventListener('click', () => {
      abrir(false);
      btn.focus();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        abrir(false);
        btn.focus();
      }
    });

    document.addEventListener('click', (e) => {
      if (!panel.hidden && !fab.contains(e.target as Node)) abrir(false);
    });

    // Aparece recién cuando el visitante pasó el hero, para no competir con sus CTAs.
    const mostrar = () => fab.classList.toggle('is-on', window.scrollY > window.innerHeight * 0.6);
    mostrar();
    window.addEventListener('scroll', mostrar, { passive: true });
  }
</script>
