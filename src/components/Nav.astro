---
import Wordmark from './Wordmark.astro';
import { nav, cta } from '../data/site';
---

<header class="bar" data-bar>
  <div class="bar-in shell">
    <a class="brand" href="#top" aria-label="Nutrición FS — inicio">
      <Wordmark size="1.6rem" />
      <span class="brand-txt mono">Nutrición<br />FS</span>
    </a>

    <nav class="links" aria-label="Secciones">
      {nav.map((l) => (
        <a class="link mono" href={l.href}>{l.label}</a>
      ))}
    </nav>

    <a class="btn btn--gold bar-cta" href={cta.presencial} target="_blank" rel="noopener">
      Pedir turno
      <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
        <path d="M1 10 10 1M10 1H3.4M10 1v6.6" stroke="currentColor" stroke-width="1.4" />
      </svg>
    </a>
  </div>
  <div class="bar-rule"></div>
</header>

<style>
  .bar {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 900;
    transition: background 0.5s var(--ease), backdrop-filter 0.5s var(--ease);
  }

  .bar.is-stuck {
    background: color-mix(in srgb, var(--ink) 82%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
            backdrop-filter: blur(14px) saturate(1.2);
  }

  .bar-rule {
    height: 1px;
    background: var(--line);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease);
  }

  .bar.is-stuck .bar-rule { transform: scaleX(1); }

  .bar-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(0.85rem, 2vw, 1.35rem);
    transition: padding 0.5s var(--ease);
  }

  .bar.is-stuck .bar-in { padding-block: 0.75rem; }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .brand-txt {
    font-size: 0.5625rem;
    line-height: 1.25;
    letter-spacing: 0.2em;
    color: var(--mute);
    padding-top: 0.1rem;
  }

  .links {
    display: none;
    gap: clamp(1.25rem, 3vw, 2.4rem);
  }

  @media (min-width: 880px) {
    .links { display: flex; }
  }

  .link {
    position: relative;
    color: var(--bone-dim);
    padding-block: 0.35rem;
    transition: color 0.3s var(--ease);
  }

  .link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease);
  }

  .link:hover { color: var(--bone); }
  .link:hover::after { transform: scaleX(1); transform-origin: left; }

  .bar-cta { padding: 0.7rem 1.1rem; }

  @media (max-width: 460px) {
    .brand-txt { display: none; }
    .bar-cta { padding: 0.65rem 0.9rem; letter-spacing: 0.1em; }
  }
</style>
