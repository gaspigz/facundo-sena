---
import { faq, cta } from '../data/site';
import SectionHead from './SectionHead.astro';
---

<section class="section faq" id="preguntas">
  <div class="shell">
    <SectionHead
      index="05"
      label="Preguntas frecuentes"
      title="Lo que más <br />me <em>preguntan</em>"
      sub="Antropometría, planes alimentarios, modalidad online y turnos. Si tu duda no está acá, escribime por WhatsApp y te la respondo."
    />

    <div class="qs">
      {faq.map((f, i) => (
        <details class="q" name="faq" style={`--d:${Math.min(i, 4) * 70}ms`} data-reveal>
          <summary class="q-head">
            <span class="mono q-n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="q-t">{f.q}</h3>
            <span class="q-ico" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                <path d="M6.5 0v13M0 6.5h13" stroke="currentColor" stroke-width="1.3" />
              </svg>
            </span>
          </summary>
          <div class="q-body"><p>{f.a}</p></div>
        </details>
      ))}
    </div>

    <p class="q-foot" data-reveal>
      <span class="mono">¿Seguís con dudas?</span>
      <a class="btn" href={cta.presencial} target="_blank" rel="noopener">
        Preguntame por WhatsApp
        <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
          <path d="M1 10 10 1M10 1H3.4M10 1v6.6" stroke="currentColor" stroke-width="1.4" />
        </svg>
      </a>
    </p>
  </div>
</section>

<style>
  .faq { background: var(--ink-2); }

  .qs { border-top: 1px solid var(--line); }

  .q { border-bottom: 1px solid var(--line); }

  .q-head {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr) 1.5rem;
    gap: 1rem;
    align-items: start;
    padding: clamp(1.15rem, 2.6vw, 1.6rem) 0;
    cursor: pointer;
    list-style: none;
    transition: color 0.35s var(--ease);
  }

  .q-head::-webkit-details-marker { display: none; }

  .q-n {
    font-size: 0.5625rem;
    color: var(--gold);
    letter-spacing: 0.2em;
    padding-top: 0.42em;
  }

  .q-t {
    font-size: clamp(0.9375rem, 1.7vw, 1.125rem);
    font-weight: 600;
    font-variation-settings: 'wdth' 100;
    line-height: 1.4;
    letter-spacing: 0;
    text-transform: none;
    color: var(--bone-dim);
    transition: color 0.35s var(--ease);
  }

  .q[open] .q-t,
  .q-head:hover .q-t { color: var(--bone); }

  .q-ico {
    display: grid;
    place-items: center;
    height: 1.5rem;
    color: var(--mute);
    transition: transform 0.45s var(--ease), color 0.35s var(--ease);
  }

  .q-head:hover .q-ico { color: var(--gold); }
  .q[open] .q-ico { transform: rotate(135deg); color: var(--gold); }

  .q-body {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr) 1.5rem;
    gap: 1rem;
    padding-bottom: clamp(1.25rem, 3vw, 1.9rem);
  }

  .q-body p {
    grid-column: 2;
    max-width: 62ch;
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.72;
    color: var(--bone-dim);
  }

  .q[open] .q-body p {
    animation: q-in 0.5s var(--ease) both;
  }

  @keyframes q-in {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: none; }
  }

  .q-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: clamp(2.25rem, 5vw, 3.25rem);
  }

  .q-foot .mono { color: var(--mute); }

  @media (prefers-reduced-motion: reduce) {
    .q[open] .q-body p { animation: none; }
  }
</style>
